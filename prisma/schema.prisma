generator client {
  provider = "prisma-client-js"
}

// Append-only administrative decision history. No contact or credential payloads.
model SecurityAuditEvent {
  id             String         @id @default(cuid())
  actorId        String
  action         String
  targetId       String
  previousStatus BusinessStatus
  nextStatus     BusinessStatus
  createdAt      DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@map("security_audit_events")
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (Auth.js) ───────────────────────────────────────

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  phone                 String?
  preferredLocale       String          @default("ht")
  onboardingStep        Int             @default(0)
  onboardingCompletedAt DateTime?
  onboardingDeferredAt  DateTime?
  role                  Role            @default(USER)
  suspendedAt           DateTime?
  mfaSecret             String?         @db.Text
  mfaLastCounter        BigInt          @default(-1)
  mfaFailedAttempts     Int             @default(0)
  mfaFailureWindowStart DateTime?
  mfaLockedUntil        DateTime?
  recoveryHashes        String[]        @default([])
  deviceSessions        DeviceSession[]
  mfaEnrollment         MfaEnrollment?
  sessionVersion        Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  accounts     Account[]
  sessions     Session[]
  registries   Registry[]
  orders       Order[]
  business     Business?
  premiumGrant PremiumGrant?
  mobileSessions MobileSession[]
  giftPledges    GiftPledge[]

  @@map("users")
}

enum Role {
  USER
  BUSINESS_OWNER
  ADMIN
  SUPERADMIN
}

model UserRoleAuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  previousRole Role
  nextRole     Role
  source       String
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt])
  @@map("user_role_audit_events")
}

model SessionRevocationEvent {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@map("session_revocation_events")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── REGISTRIES ───────────────────────────────────────────

enum RegistryType {
  BABY_SHOWER
  WEDDING
  BIRTHDAY
  CHRISTMAS
  SHOPPING
  OTHER
}

enum RegistryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Registry {
  id               String         @id @default(cuid())
  slug             String         @unique
  userId           String
  type             RegistryType
  status           RegistryStatus @default(DRAFT)
  title            String
  description      String?        @db.Text
  eventDate        DateTime?
  coverImage       String?
  locale           String         @default("ht")
  kind             String         @default("SELF") @db.VarChar(30)
  recipientName    String?        @db.VarChar(100)
  recipientMessage String?        @db.VarChar(1000)
  visibility       String         @default("PUBLIC") @db.VarChar(20)
  searchable       Boolean        @default(false)
  palette          String         @default("mint") @db.VarChar(20)
  /// Where the celebration happens, shown to guests. Free text, optional.
  place            String?        @db.VarChar(80)

  ogImageUrl String?

  amazonWishlistUrl String?
  externalLinks     Json?

  isPublic Boolean @default(true)
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   RegistryItem[]
  pledges GiftPledge[]

  @@index([userId])
  @@index([slug])
  @@index([status, isPublic, createdAt])
  @@index([userId, status, updatedAt])
  @@index([status, visibility, searchable, title, id])
  @@index([userId, kind, updatedAt])
  @@map("registries")
}

// ─── REGISTRY ITEMS ───────────────────────────────────────

enum ItemSource {
  CUSTOM
  LOCAL_BUSINESS
  AMAZON
  EXTERNAL
}

enum ItemStatus {
  AVAILABLE
  PARTIALLY_FULFILLED
  FULFILLED
}

model RegistryItem {
  id           String     @id @default(cuid())
  registryId   String
  title        String
  description  String?    @db.Text
  imageUrl     String?
  priceHTG     Decimal?   @db.Decimal(12, 2)
  priceUSD     Decimal?   @db.Decimal(12, 2)
  quantity     Int        @default(1)
  fulfilledQty Int        @default(0)
  reservedQty  Int        @default(0)
  status       ItemStatus @default(AVAILABLE)
  source       ItemSource @default(CUSTOM)

  externalUrl String?

  businessId String?
  productId  String?

  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registry   Registry    @relation(fields: [registryId], references: [id], onDelete: Cascade)
  business   Business?   @relation(fields: [businessId], references: [id])
  orderItems OrderItem[]
  pledges    GiftPledge[]

  @@index([registryId])
  @@index([businessId])
  @@map("registry_items")
}

// ─── BUSINESSES ───────────────────────────────────────────

enum BusinessStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

model Business {
  id            String  @id @default(cuid())
  ownerId       String  @unique
  name          String
  slug          String  @unique
  description   String? @db.Text
  logoUrl       String?
  coverUrl      String?
  category      String
  patenteNumber String? @db.VarChar(100)

  city       String?
  department String?
  address    String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?

  moncashNumber   String?
  natcashNumber   String?
  stripeAccountId String?

  status            BusinessStatus        @default(PENDING_REVIEW)
  fulfillmentPolicy String?               @db.VarChar(2000)
  fulfillments      MerchantFulfillment[]
  refunds           RefundRequest[]
  commissionRate    Decimal               @default(0.0) @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items          RegistryItem[]
  products       Product[]
  paymentProfile MerchantPaymentProfile?

  @@index([slug])
  @@index([status, name])
  @@map("businesses")
}

model Product {
  media         ProductMedia[]
  id            String         @id @default(cuid())
  businessId    String
  name          String
  description   String?        @db.Text
  imageUrl      String?
  priceHTG      Decimal?       @db.Decimal(12, 2)
  priceUSD      Decimal?       @db.Decimal(12, 2)
  inStock       Boolean        @default(true)
  // Unsold physical units, including active checkout holds. Null is unconfirmed.
  stockQuantity Int?
  reservedStock Int            @default(0)
  category      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([inStock, name, id])
  @@index([inStock, priceUSD, id], map: "products_available_usd")
  @@index([inStock, priceHTG, id], map: "products_available_htg")
  @@map("products")
}

// Private setup intent only. No secrets, bank numbers or provider verification claims.
model MerchantPaymentProfile {
  businessId  String   @id
  provider    String   @db.VarChar(20)
  requestedAt DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("merchant_payment_profiles")
}

model PremiumGrant {
  userId    String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("premium_grants")
}

model PremiumAuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([targetId, createdAt], map: "premium_audit_target_created")
  @@map("premium_audit_events")
}

// ─── ORDERS & PAYMENTS ────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MONCASH
  NATCASH
  EXTERNAL_REDIRECT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  checkoutRequestId        String? @unique
  checkoutRequestHash      String?
  checkoutLocale           String?
  id                       String  @id @default(cuid())
  orderNumber              String  @unique
  buyerId                  String?
  buyerName                String
  buyerEmail               String
  buyerPhone               String?
  giftMessage              String? @db.Text
  deliveryContactEncrypted String? @db.Text
  isAnonymous              Boolean @default(false)

  totalHTG    Decimal? @db.Decimal(12, 2)
  totalUSD    Decimal? @db.Decimal(12, 2)
  platformFee Decimal? @db.Decimal(12, 2)

  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer          User?                 @relation(fields: [buyerId], references: [id])
  items          OrderItem[]
  payment        Payment?
  fulfillments   MerchantFulfillment[]
  refundRequests RefundRequest[]

  @@index([buyerId])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  registryItemId String
  // Immutable inventory identity at purchase; nullable only for historical rows.
  productId      String?
  quantity       Int      @default(1)
  priceHTG       Decimal? @db.Decimal(12, 2)
  priceUSD       Decimal? @db.Decimal(12, 2)

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  registryItem RegistryItem @relation(fields: [registryItemId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([registryItemId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id       String          @id @default(cuid())
  orderId  String          @unique
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  stripePaymentId String?
  checkoutUrl     String? @db.Text
  paypalOrderId   String?
  moncashTxId     String?
  natcashTxId     String?

  // Provider event ID (e.g. Stripe event.id) — used to make webhook handlers
  // idempotent. Unique so a duplicate delivery is rejected at the DB level.
  providerEventId String? @unique

  amountHTG Decimal? @db.Decimal(12, 2)
  amountUSD Decimal? @db.Decimal(12, 2)
  currency  String

  providerResponse Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([stripePaymentId])
  @@index([moncashTxId])
  @@index([status, currency, createdAt], map: "payment_status_currency_created")
  @@map("payments")
}

model DeviceSession {
  id               String    @id @default(cuid())
  userId           String
  label            String    @default("Browser session") @db.VarChar(80)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  mfaVerifiedUntil DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("device_sessions")
}

model MfaEnrollment {
  deviceId        String   @default("") @db.VarChar(100)
  userId          String   @id
  encryptedSecret String   @db.Text
  expiresAt       DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_enrollments")
}

model OperationAuditEvent {
  id            String   @id @default(cuid())
  actorId       String
  action        String   @db.VarChar(60)
  entityType    String   @db.VarChar(30)
  targetId      String
  previousValue String?  @db.VarChar(100)
  nextValue     String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@index([createdAt, id])
  @@index([targetId, createdAt])
  @@map("operation_audit_events")
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.VarChar(2048)
  alt       String  @db.VarChar(200)
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_media")
}

model MerchantFulfillment {
  id           String   @id @default(cuid())
  orderId      String
  businessId   String
  state        String   @default("NEW") @db.VarChar(30)
  method       String   @default("PICKUP") @db.VarChar(20)
  instructions String?  @db.VarChar(1000)
  updatedAt    DateTime @updatedAt
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([orderId, businessId])
  @@index([businessId, state, updatedAt])
  @@map("merchant_fulfillments")
}

model RefundRequest {
  id          String   @id @default(cuid())
  orderId     String
  businessId  String
  requesterId String
  kind        String   @db.VarChar(20)
  state       String   @default("REQUESTED") @db.VarChar(30)
  reason      String   @db.VarChar(1000)
  amountMinor BigInt
  currency    String   @db.VarChar(3)
  // Filled only when state is REFUNDED: evidence the merchant recorded, not a provider confirmation.
  refundMethod     String?   @db.VarChar(20)
  refundReference  String?   @db.VarChar(100)
  refundedAt       DateTime?
  refundRecordedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([orderId, businessId])
  @@index([businessId, state, createdAt])
  @@map("refund_requests")
}

model SeasonCampaign {
  id        String   @id @default(cuid())
  titleEN   String   @db.VarChar(120)
  titleFR   String   @db.VarChar(120)
  titleHT   String   @db.VarChar(120)
  season    String   @db.VarChar(20)
  kind      String   @db.VarChar(20)
  occasion  String   @db.VarChar(20)
  startsAt  DateTime
  endsAt    DateTime
  priority  Int      @default(0)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([enabled, startsAt, endsAt, priority])
  @@map("season_campaigns")
}

model SiteSettings {
  id              String  @id @default("site")
  seasonalEnabled Boolean @default(true)

  @@map("site_settings")
}

/// A signed-in session on the mobile app. Only a SHA-256 of the bearer token is stored.
/// Copies the account's sessionVersion so "sign out everywhere" on the web ends it too.
model MobileSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique @db.Char(64)
  label          String    @default("Bayou app") @db.VarChar(80)
  sessionVersion Int
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("mobile_sessions")
}

/// One-time 6-digit sign-in code sent by email to the mobile app. Only a keyed hash is stored.
model EmailSignInCode {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(254)
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("email_sign_in_codes")
}

/// "I'll give this": a signed-in guest promises to bring a gift. No money moves through Bayou.
/// Active pledges are counted in the item's fulfilledQty so every progress view agrees.
model GiftPledge {
  id          String       @id @default(cuid())
  itemId      String
  registryId  String
  userId      String
  quantity    Int
  isAnonymous Boolean      @default(false)
  message     String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  cancelledAt DateTime?
  item        RegistryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  registry    Registry     @relation(fields: [registryId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([registryId])
  @@index([userId, createdAt])
  @@map("gift_pledges")
}

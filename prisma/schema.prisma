generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime: Neon *pooled* URL (-pooler host, ?pgbouncer=true&connection_limit=1).
  url       = env("DATABASE_URL")
  // Migrations / introspection: unpooled URL. Locally/CI set it equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─── AUTH (Auth.js) ───────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  phone           String?
  preferredLocale String    @default("ht")
  role            Role      @default(USER)
  // Bumped to invalidate every JWT for this user (logout-everywhere, ban, role change).
  tokenVersion    Int       @default(0)
  bannedAt        DateTime?
  // Soft delete / anonymisation marker for account deletion (WS6).
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  registries Registry[]
  orders     Order[]
  business   Business?
  uploads    Upload[]

  @@map("users")
}

enum Role {
  USER
  BUSINESS_OWNER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── REGISTRIES ───────────────────────────────────────────

enum RegistryType {
  BABY_SHOWER
  WEDDING
  BIRTHDAY
}

enum RegistryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Registry {
  id          String         @id @default(cuid())
  slug        String         @unique
  userId      String
  type        RegistryType
  status      RegistryStatus @default(DRAFT)
  title       String
  description String?        @db.Text
  eventDate   DateTime?
  coverImage  String?
  locale      String         @default("ht")

  ogImageUrl String?

  amazonWishlistUrl String?
  externalLinks     Json?

  isPublic   Boolean @default(true)
  password   String?
  // Unguessable token for sharing a private registry (?share=<token>).
  shareToken String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  RegistryItem[]
  orders Order[]

  @@index([userId])
  @@index([status, isPublic])
  @@map("registries")
}

// ─── REGISTRY ITEMS ───────────────────────────────────────

enum ItemSource {
  CUSTOM
  LOCAL_BUSINESS
  AMAZON
  EXTERNAL
}

enum ItemStatus {
  AVAILABLE
  PARTIALLY_FULFILLED
  FULFILLED
}

model RegistryItem {
  id           String     @id @default(cuid())
  registryId   String
  title        String
  description  String?    @db.Text
  imageUrl     String?
  priceHTG     Decimal?   @db.Decimal(12, 2)
  priceUSD     Decimal?   @db.Decimal(12, 2)
  quantity     Int        @default(1)
  fulfilledQty Int        @default(0)
  status       ItemStatus @default(AVAILABLE)
  source       ItemSource @default(CUSTOM)

  externalUrl String?

  businessId String?
  productId  String?

  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registry   Registry    @relation(fields: [registryId], references: [id], onDelete: Cascade)
  business   Business?   @relation(fields: [businessId], references: [id])
  orderItems OrderItem[]

  @@index([registryId])
  @@index([businessId])
  @@map("registry_items")
}

// ─── BUSINESSES ───────────────────────────────────────────

enum BusinessStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

model Business {
  id          String  @id @default(cuid())
  ownerId     String  @unique
  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?
  coverUrl    String?
  category    String

  city       String?
  department String?
  address    String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?

  moncashNumber   String?
  natcashNumber   String?
  stripeAccountId String?

  status         BusinessStatus @default(PENDING_REVIEW)
  commissionRate Decimal        @default(5.0) @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items    RegistryItem[]
  products Product[]

  @@index([status, name])
  @@map("businesses")
}

model Product {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?   @db.Text
  imageUrl    String?
  priceHTG    Decimal?  @db.Decimal(12, 2)
  priceUSD    Decimal?  @db.Decimal(12, 2)
  inStock     Boolean   @default(true)
  category    String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, inStock])
  @@map("products")
}

// ─── ORDERS & PAYMENTS ────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  EXPIRED
  PAYMENT_FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MONCASH
  NATCASH
  EXTERNAL_REDIRECT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  // Unguessable key used in success/instructions URLs instead of orderNumber (H3).
  publicToken String  @unique @default(cuid())
  // Registry this order belongs to (one registry per order). Nullable for
  // rows created before this migration; backfilled from order_items.
  registryId  String?
  buyerId     String?
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  giftMessage String? @db.Text
  isAnonymous Boolean @default(false)

  totalHTG    Decimal? @db.Decimal(12, 2)
  totalUSD    Decimal? @db.Decimal(12, 2)
  platformFee Decimal? @db.Decimal(12, 2)

  status    OrderStatus @default(PENDING)
  // PENDING orders past this time are moved to EXPIRED by the expire-orders cron.
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer    User?       @relation(fields: [buyerId], references: [id])
  registry Registry?   @relation(fields: [registryId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?

  @@index([buyerId])
  @@index([status, createdAt])
  @@index([registryId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  registryItemId String
  quantity       Int      @default(1)
  priceHTG       Decimal? @db.Decimal(12, 2)
  priceUSD       Decimal? @db.Decimal(12, 2)

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  registryItem RegistryItem @relation(fields: [registryItemId], references: [id])

  @@index([orderId])
  @@index([registryItemId])
  @@map("order_items")
}

model Payment {
  id       String          @id @default(cuid())
  orderId  String          @unique
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  stripePaymentId String?
  paypalOrderId   String?
  moncashTxId     String?
  natcashTxId     String?

  // Provider-agnostic transaction id (PayPal capture id, MonCash transactionId,
  // Stripe payment_intent). Unique per provider so a tx can only settle one order.
  providerTxId String?

  // Provider event ID (e.g. Stripe event.id) — used to make webhook handlers
  // idempotent. Unique so a duplicate delivery is rejected at the DB level.
  providerEventId String? @unique

  amountHTG      Decimal? @db.Decimal(12, 2)
  amountUSD      Decimal? @db.Decimal(12, 2)
  currency       String
  // Amount the provider must report for this payment to be accepted (C2-C4).
  amountExpected Decimal? @db.Decimal(12, 2)

  // Manual (Natcash) confirmation by an admin.
  manualReference     String?
  manualConfirmedById String?
  manualConfirmedAt   DateTime?

  providerResponse Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([stripePaymentId])
  @@index([moncashTxId])
  @@index([paypalOrderId])
  @@index([status, createdAt])
  @@map("payments")
}

// ─── PLATFORM: EMAIL OUTBOX, AUDIT, UPLOADS ───────────────

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Transactional email queue (WS4). Rows are inserted by enqueueEmail() and
// drained by the send-emails cron. dedupeKey makes enqueueing idempotent.
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  template  String
  locale    String      @default("ht")
  payload   Json
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?     @db.Text
  dedupeKey String      @unique
  sendAfter DateTime    @default(now())
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, sendAfter])
  @@map("email_outbox")
}

// Append-only log of privileged actions (admin confirms, refunds, bans...).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Every presigned upload. attachedAt is set when a row starts referencing the
// object; unattached rows older than 24h are deleted by the cleanup cron.
model Upload {
  id         String    @id @default(cuid())
  key        String    @unique
  ownerId    String
  context    String
  contextId  String
  attachedAt DateTime?
  createdAt  DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([attachedAt, createdAt])
  @@index([ownerId])
  @@map("uploads")
}

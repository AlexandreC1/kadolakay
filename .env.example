# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kadolakay

# Auth.js
AUTH_SECRET= # Generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (email magic links)
AUTH_RESEND_KEY=
AUTH_RESEND_FROM="KadoLakay <noreply@kadolakay.com>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox # sandbox or live

# MonCash (Digicel)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox # sandbox or live

# Natcash
NATCASH_MERCHANT_NUMBER=

# S3-compatible storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=kadolakay
S3_REGION=auto
S3_PUBLIC_URL= # e.g., https://cdn.kadolakay.com

# Migrations (unpooled Neon URL); app uses the pooled DATABASE_URL (WS7).
# REQUIRED by prisma/schema.prisma (directUrl). Locally, same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kadolakay

# Rate limiting (REQUIRED in production; app fails closed without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron + deep health check (openssl rand -hex 32)
CRON_SECRET=
HEALTH_TOKEN=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature flags (true/false). Defaults: Stripe/PayPal/MonCash on, Natcash off
# (no admin screen to confirm Natcash transfers yet), email queue off.
STRIPE_ENABLED=true
PAYPAL_ENABLED=true
MONCASH_ENABLED=true
NATCASH_ENABLED=false
EMAIL_QUEUE_ENABLED=false
MAINTENANCE_MODE=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kadolakay

# Auth.js
AUTH_SECRET= # Generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (email magic links)
AUTH_RESEND_KEY=
AUTH_RESEND_FROM="KadoLakay <noreply@kadolakay.com>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox # sandbox or live

# MonCash (Digicel)
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox # sandbox or live

# Natcash
NATCASH_MERCHANT_NUMBER=

# S3-compatible storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=kadolakay
S3_REGION=auto
S3_PUBLIC_URL= # e.g., https://cdn.kadolakay.com

# Optional social sign-in (only complete providers are displayed)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0/
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared rate limiting (required for production requests)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled payment reconciliation, use a random secret of at least 32 characters
CRON_SECRET=

# New purchases remain disabled until seller/fulfillment/refund rules and live checks pass.
CHECKOUT_ENABLED=false
# Existing Stripe implementation is for sandbox verification only.
# Merchant-direct payments for the Haiti marketplace are not live yet.
PAYMENT_MODE=disabled
# Optional hourly recovery. Keep disabled before provider onboarding; webhooks remain primary.
RECONCILIATION_ENABLED=false

# Optional monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
